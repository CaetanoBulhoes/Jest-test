{
  "name": "ferramenta-teste-jest",
  "version": "1.0.0",
  "main": "index.js",
  "dependencies": {
    "expo": "~58.0.19",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-native": "0.88.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "test:smoke": "jest tests/01_login.test.js",
    "test:carga": "jest tests/05_carga_ui.test.js tests/06_carga_api.test.js",
    "test:cobertura": "jest --coverage"
  },
  "private": true,
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.12",
    "test-renderer": "^1.3.1"
  },
  "jest": {
    "testTimeout": 30000,
    "collectCoverageFrom": [
      "App.js",
      "src/**/*.js"
    ],
    "projects": [
      {
        "displayName": "app",
        "preset": "jest-expo",
        "testMatch": [
          "<rootDir>/tests/**/*.test.js"
        ],
        "testPathIgnorePatterns": [
          "/node_modules/",
          "06_carga_api"
        ]
      },
      {
        "displayName": "carga-api",
        "testEnvironment": "node",
        "testMatch": [
          "<rootDir>/tests/06_carga_api.test.js"
        ]
      }
    ]
  }
}
